# GeoBaller world query 4a1: league, competition class (women's/youth/reserve) and sport. One row per club, field and value.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?club ?field ?value ?value_name WHERE {
  ?club wdt:P31 ?type . ?type wdt:P279* wd:Q476028 .
  { ?club wdt:P118 ?value . BIND("league" AS ?field) }
  UNION { ?club wdt:P2094 ?value . BIND("competition_class" AS ?field) }
  UNION { ?club wdt:P641 ?value . BIND("sport" AS ?field) }
  OPTIONAL { ?value rdfs:label ?value_name . FILTER(LANG(?value_name) = "en") }
}
